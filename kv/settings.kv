<SettingsTab>:
    orientation: "vertical"

    ScrollView:
        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "16dp"
            adaptive_height: True

            MDLabel:
                id: settings_title
                text: "Settings"
                font_style: "H5"

            # Language
            MDCard:
                orientation: "vertical"
                padding: "20dp"
                spacing: "12dp"
                size_hint_y: None
                height: self.minimum_height
                radius: [16, 16, 16, 16]
                elevation: 2

                MDLabel:
                    id: language_label
                    text: "Language"
                    font_style: "Subtitle1"
                    bold: True

                MDBoxLayout:
                    spacing: "12dp"

                    MDRaisedButton:
                        id: btn_ar
                        text: "Arabic"
                        on_release: root.set_language("ar")

                    MDRaisedButton:
                        id: btn_en
                        text: "English"
                        on_release: root.set_language("en")

            # Appearance
            MDCard:
                orientation: "vertical"
                padding: "20dp"
                spacing: "8dp"
                size_hint_y: None
                height: self.minimum_height
                radius: [16, 16, 16, 16]
                elevation: 2

                MDLabel:
                    id: appearance_label
                    text: "Appearance"
                    font_style: "Subtitle1"
                    bold: True

                MDBoxLayout:
                    spacing: "8dp"

                    MDLabel:
                        id: dark_label
                        text: "Dark Mode"

                    MDSwitch:
                        id: dark_switch
                        pos_hint: {"center_y": 0.5}
                        on_active: root.toggle_dark(self.active)

            # Network
            MDCard:
                orientation: "vertical"
                padding: "20dp"
                spacing: "8dp"
                size_hint_y: None
                height: self.minimum_height
                radius: [16, 16, 16, 16]
                elevation: 2

                MDLabel:
                    id: network_label
                    text: "Network"
                    font_style: "Subtitle1"
                    bold: True

                MDTextField:
                    id: port_field
                    hint_text: "Server Port"
                    text: "2121"
                    mode: "rectangle"
                    input_filter: "int"
                    on_text: root.on_port(self.text)

            # About
            MDCard:
                orientation: "vertical"
                padding: "20dp"
                spacing: "8dp"
                size_hint_y: None
                height: self.minimum_height
                radius: [16, 16, 16, 16]
                elevation: 2

                MDLabel:
                    id: about_label
                    text: "About"
                    font_style: "Subtitle1"
                    bold: True

                MDLabel:
                    id: about_value
                    text: ""
                    font_style: "Body2"
                    theme_text_color: "Hint"