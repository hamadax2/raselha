#:import get_color_from_hex kivy.utils.get_color_from_hex

MDScreen:
    md_bg_color: get_color_from_hex("#0f1117")

    MDBoxLayout:
        orientation: "vertical"

        # ── Top Bar ──────────────────────────────────────────
        MDBoxLayout:
            id: top_bar
            orientation: "horizontal"
            size_hint_y: None
            height: "60dp"
            padding: ["20dp", "10dp", "20dp", "0dp"]
            spacing: "8dp"
            md_bg_color: get_color_from_hex("#0f1117")

            MDLabel:
                id: top_title
                text: "FileShare"
                font_name: "Cairo"
                font_style: "H5"
                bold: True
                size_hint_x: 1
                theme_text_color: "Custom"
                text_color: get_color_from_hex("#00d4aa")

            MDIcon:
                id: server_dot
                icon: "circle"
                theme_text_color: "Custom"
                text_color: get_color_from_hex("#4a5278")
                size_hint: None, None
                size: "16dp", "16dp"
                pos_hint: {"center_y": 0.5}

        # ── Screens ──────────────────────────────────────────
        ScreenManager:
            id: screen_manager

            Screen:
                name: "server"
                HomeTab:
                    id: home_tab

            Screen:
                name: "send"
                SendTab:
                    id: send_tab

            Screen:
                name: "receive"
                ReceiveTab:
                    id: receive_tab

            Screen:
                name: "settings"
                SettingsTab:
                    id: settings_tab

        # ── Bottom Navigation ─────────────────────────────────
        MDBoxLayout:
            id: bottom_nav
            orientation: "horizontal"
            size_hint_y: None
            height: "64dp"
            padding: ["0dp", "4dp", "0dp", "4dp"]
            md_bg_color: get_color_from_hex("#1a1d27")

            NavItem:
                id: nav_server
                nav_icon: "server-network"
                nav_text: "Server"
                tab_name: "server"
                active: True

            NavItem:
                id: nav_send
                nav_icon: "send"
                nav_text: "Send"
                tab_name: "send"

            NavItem:
                id: nav_receive
                nav_icon: "folder-download"
                nav_text: "Files"
                tab_name: "receive"

            NavItem:
                id: nav_settings
                nav_icon: "cog"
                nav_text: "Settings"
                tab_name: "settings"
